# Copy to .env (git-ignored). Loaded automatically by ./dev and ./dev.ps1.
# SETUP: list the variables this project uses; never put real secrets here.
#
# Format: one KEY=value per line. The file is parsed, not executed: no `export`,
# no $VAR expansion, no inline comments. A value may be wrapped in one pair of
# single or double quotes; lines starting with # are ignored.

# Integration tests (tests/README.md)
# <PROJECT>_TEST_URL=https://example.invalid
# <PROJECT>_TEST_TOKEN=
# <PROJECT>_ALLOW_DISRUPTIVE=0
